<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F7FB">
  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#3069E8"/>
    <SolidColorBrush x:Key="Ink" Color="#202B40"/>
    <SolidColorBrush x:Key="Muted" Color="#778398"/>
    <DrawingImage x:Key="AppIcon">
      <DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#3069E8" Geometry="M 10,0 L 54,0 Q 64,0 64,10 L 64,54 Q 64,64 54,64 L 10,64 Q 0,64 0,54 L 0,10 Q 0,0 10,0 Z"/>
        <GeometryDrawing Brush="#91C5FF" Geometry="M 16,20 L 32,11 L 48,20 L 32,29 Z"/>
        <GeometryDrawing Brush="White" Geometry="M 16,25 L 29,32 L 29,49 L 16,42 Z"/>
        <GeometryDrawing Brush="#C8E2FF" Geometry="M 35,32 L 48,25 L 48,42 L 35,49 Z"/>
      </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,10"/>
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#E0E6EF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.82"/><Setter TargetName="Body" Property="BorderBrush" Value="#90B3FF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.66"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#3069E8"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F8FAFD"/>
      <Setter Property="BorderBrush" Value="#DEE5F0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Frame" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#3069E8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5EAF2"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="24,22"/>
    </Style>
  </Grid.Resources>
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
  <Grid MinWidth="740" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" HorizontalAlignment="Left">
  <Grid Margin="28,24,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="184"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="{StaticResource AppIcon}" Width="52" Height="52" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="PCL-Helper" FontSize="27" FontWeight="SemiBold"/>
        <TextBlock Text="下载与整合包安装修复助手" Foreground="{StaticResource Muted}" FontSize="12" Margin="1,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="2" Background="#EAF1FF" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
        <TextBlock Text="支持 PCL 2.99.0.0" Foreground="#3863AD" FontSize="11"/>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="#EDF3FF" CornerRadius="12" Padding="18,15" Margin="0,0,0,18">
      <UniformGrid Columns="3">
        <StackPanel Orientation="Horizontal"><TextBlock Text="01" Foreground="#3069E8" FontWeight="Bold" Margin="0,0,10,0"/><TextBlock Text="选择 PCL 程序" Foreground="#4C6286" FontSize="12"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="02" Foreground="#3069E8" FontWeight="Bold" Margin="0,0,10,0"/><TextBlock Text="退出 PCL 并恢复" Foreground="#4C6286" FontSize="12"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="03" Foreground="#3069E8" FontWeight="Bold" Margin="0,0,10,0"/><TextBlock Text="启动 PCL，继续下载" Foreground="#4C6286" FontSize="12"/></StackPanel>
      </UniformGrid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="PCL 程序" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="FileName" Text="尚未选择文件" Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="PathBox" Height="44" AutomationProperties.Name="PCL 程序路径" ToolTip="粘贴 PCL 程序路径，或将文件拖入窗口" HorizontalScrollBarVisibility="Hidden"/>
          <Button x:Name="FindPcl" Grid.Column="1" Content="一键查找 PCL" Height="44" Margin="10,0,0,0" Padding="13,10" Background="#EDF3FF" Foreground="#3069E8" BorderBrush="#EDF3FF" ToolTip="查找桌面、下载目录和快捷方式，必要时扫描本地磁盘；支持取消"/>
          <Button x:Name="Browse" Grid.Column="2" Height="44" Margin="10,0,0,0" Background="#EDF3FF" Foreground="#3069E8" BorderBrush="#EDF3FF" ToolTip="选择文件 (Ctrl+O)">
            <StackPanel Orientation="Horizontal"><Path Data="M1,4 L6,4 L8,6 L15,6 L15,14 L1,14 Z M1,4 L1,2 L6,2 L8,4 L15,4 L15,6" Stroke="#3069E8" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="选择文件" Foreground="#3069E8"/></StackPanel>
          </Button>
        </Grid>
        <TextBlock Text="不知道程序在哪？点击「一键查找 PCL」。也可手动选择或拖入文件。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,18"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="Enable" Content="恢复下载" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" ToolTip="先退出 PCL；自动保留原始备份"/>
          <Button x:Name="Inspect" Grid.Column="2" Content="检查状态" ToolTip="检查版本和当前状态 (F5)"/>
          <Button x:Name="Restore" Grid.Column="4" Content="还原原版" ToolTip="使用经过 SHA256 校验的备份还原"/>
          <Button x:Name="Launch" Grid.Column="6" Content="启动 PCL" ToolTip="启动已检查的 PCL 程序"/>
        </Grid>
        <Border x:Name="SearchPanel" Visibility="Collapsed" Background="#F8FAFD" CornerRadius="10" Padding="14" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock x:Name="SearchSummary" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox x:Name="SearchResults" MaxHeight="160" MinHeight="64" Background="White" BorderBrush="#DEE5F0" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" AutomationProperties.Name="找到的 PCL 程序列表">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,6">
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="{Binding Path}" Foreground="#778398" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="UseFound" Content="使用选中的程序" HorizontalAlignment="Left" Margin="0,10,0,0" MinHeight="36" Padding="14,7"/>
            <TextBlock Text="仅支持修复 PCL 2.99.0.0。搜索不会修改或运行找到的程序。" FontSize="10" Foreground="#778398" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="StateIcon" Background="#EDF3FF" Width="40" Height="40" CornerRadius="11" Margin="0,0,12,0" VerticalAlignment="Top">
            <TextBlock x:Name="StateGlyph" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#3069E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="StateTitle" Text="准备就绪，从选择文件开始" FontSize="16" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="StateHint" Text="原程序自动备份，可通过「还原原版」撤销。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,12,0" TextWrapping="Wrap"/>
          </StackPanel>
          <Border x:Name="StateBadge" Grid.Column="2" Background="#EDF3FF" Padding="10,5" CornerRadius="11" VerticalAlignment="Top">
            <TextBlock x:Name="StateTag" Text="待操作" Foreground="#3069E8" FontSize="10"/>
          </Border>
        </Grid>
        <ProgressBar x:Name="BusyProgress" Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,15,0,0" BorderThickness="0" Foreground="#3069E8" Background="#EDF3FF" AutomationProperties.Name="操作进度"/>
        <Border Grid.Row="2" Background="#F8FAFD" CornerRadius="10" Margin="0,18,0,0" Padding="12,8">
          <TextBox x:Name="Details" Text="支持恢复 Minecraft 下载与整合包安装入口。&#x0a;选择文件后会检查版本和下载状态。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0" FontSize="12" Foreground="#6C7890" VerticalContentAlignment="Top" AutomationProperties.Name="操作详情（可选择复制）"/>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="4" Margin="2,16,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Turing Mirror Software · 第三方工具，与 PCL 官方无关联" Foreground="#8A95A7" FontSize="10" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="v1.1 · UI 优化版" Foreground="#8A95A7" FontSize="10"/>
    </Grid>
  </Grid>
  </Grid>
  </ScrollViewer>
</Grid>
